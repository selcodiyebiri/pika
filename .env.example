# local | production. Production refuses to start with debug on, a weak PIKA_LICENSE or a non-https SITE_URL.
APP_ENV=production
APP_DEBUG=false
# Generate with: php pika key:generate
PIKA_LICENSE=
# Required in production, e.g. https://example.com (or https://example.com/sub-folder)
SITE_URL=
ADMIN_URL=admin
APP_TIMEZONE=Europe/Istanbul

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional unix socket path (overrides host/port), e.g. MAMP: /Applications/MAMP/tmp/mysql/mysql.sock
MYSQL_SOCKET=
MYSQL_DB=pika
MYSQL_USER=root
MYSQL_PASS=

# HTTP cron endpoint /api/cron/<job> (header X-Cron-Token). Empty = disabled. Use 32+ random characters, e.g. openssl rand -hex 32
CRON_TOKEN=
# Optional: e-mail one alert when a job starts failing (needs working MAIL_*). Empty = off.
CRON_ALERT_EMAIL=

# Comma-separated IPs of reverse proxies whose X-Forwarded-* headers are trusted
TRUSTED_PROXIES=

# Sessions (seconds)
SESSION_IDLE=1800
SESSION_ABSOLUTE=28800

# RateLimit middleware: requests per window (seconds) per IP
RATE_LIMIT=60
RATE_WINDOW=60

# Mail: "smtp" (production) or "log" (APP_ENV=local only; writes mails to content/logs)
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=Pika

# Optional: replace the default Content-Security-Policy ({nonce} is replaced per request)
CSP=
